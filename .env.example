# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/akazi_hub?schema=public"

# SMS / OTP provider (e.g. Africa's Talking, Twilio) — used for phone-based auth
OTP_PROVIDER_API_KEY=""
OTP_PROVIDER_SENDER_ID="AkaziHub"
OTP_PROVIDER_USERNAME="sandbox"
# "sandbox" = simulated sends (no real SMS). Set to "production" to deliver real SMS.
OTP_PROVIDER_ENVIRONMENT="sandbox"
# Demo only: set to "true" to display the OTP code in the UI on the deployed site.
OTP_DEMO_MODE="false"
# Admin bootstrap: the phone (E.164) that is promoted to ADMIN role on login.
ADMIN_PHONE=""

# Mobile Money collections (MTN MoMo / Airtel Money) API credentials
MOMO_API_KEY=""
MOMO_API_SECRET=""
MOMO_TARGET_ENVIRONMENT="sandbox"

# WhatsApp Business support number (E.164, no +)
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER="250794626004"
